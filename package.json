{
  "name": "client-site-starter",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply weall-local --local",
    "db:seed:local": "wrangler d1 execute weall-local --local --file seed/0001_messages.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.157.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
